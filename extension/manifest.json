{
  "manifest_version": 3,
  "name": "Paper Crawler: research papers in Bangla",
  "short_name": "Paper Crawler",
  "version": "0.1.0",
  "description": "A spider reads arXiv papers with you and explains each section in simple Bangla and English. Free, on-device AI, no account.",
  "minimum_chrome_version": "138",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "optional_permissions": ["debugger"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Paper Crawler: explain this paper",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [
    {
      "matches": ["https://arxiv.org/html/*", "https://ar5iv.labs.arxiv.org/html/*", "https://ar5iv.org/html/*"],
      "js": ["content.js"],
      "css": ["css/markup.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["js/*"],
      "matches": ["https://arxiv.org/*", "https://ar5iv.labs.arxiv.org/*", "https://ar5iv.org/*"]
    }
  ]
}
